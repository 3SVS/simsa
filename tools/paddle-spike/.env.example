# 이 파일을 tools/paddle-spike/.env.local 로 복사해서 값을 채우세요.
# .env.local 은 .gitignore 대상입니다 — 절대 커밋하지 않습니다.
# 샌드박스 값만 넣습니다. 라이브 API 키·라이브 client-side token 은 도구가 요청 전에 거부합니다.

# sandbox-vendors.paddle.com → Developer tools → Authentication → API keys
PADDLE_SANDBOX_API_KEY=

# sandbox-vendors.paddle.com → Developer tools → Authentication → Client-side tokens (test 로 시작)
PADDLE_SANDBOX_CLIENT_TOKEN=

# 선택 — 비우면 기본값을 씁니다.
# 체크아웃 미리 채움 이메일(공백·한글 불가, Paddle.js 요건). 기본 paddle-spike@example.com
# PADDLE_SPIKE_CUSTOMER_EMAIL=
# customData 로 보내는 프로젝트명(한글 왕복 확인용). 기본 "(주)트루픽셀 — 우리 동네 빵집 예약 앱"
# PADDLE_SPIKE_PROJECT_NAME=
